# blue-data environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# Usage:
#   source .env                      # shell
#   docker run --env-file .env ...   # Docker

# ---------------------------------------------------------------------------
# Store — registry persistence backend
# ---------------------------------------------------------------------------
BLUE_DATA_STORE=memory               # memory | redis | file

# Redis (required when BLUE_DATA_STORE=redis)
# Requires Redis Stack (redis-stack-server), not plain Redis.
BLUE_DATA_REDIS_URL=redis://localhost:6379/0
BLUE_DATA_REDIS_NAMESPACE=blue_data

# File (required when BLUE_DATA_STORE=file, json-mcp only)
BLUE_DATA_FILE=blue_data_store.json

# ---------------------------------------------------------------------------
# LLM — enables AI-augmented metadata enrichment (optional)
# ---------------------------------------------------------------------------
BLUE_DATA_LLM_PROVIDER=              # anthropic | openai (leave blank to disable)
BLUE_DATA_LLM_MODEL=                 # claude-opus-4-8 (anthropic default) | gpt-4o (openai default)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Registry — search tuning
# ---------------------------------------------------------------------------
BLUE_DATA_REGISTRY_VECTOR_DIM=1536
BLUE_DATA_REGISTRY_SEARCH_BM25_WEIGHT=0.3
BLUE_DATA_REGISTRY_SEARCH_VECTOR_WEIGHT=0.7
BLUE_DATA_REGISTRY_SEARCH_VALUE_WEIGHT=0.15
BLUE_DATA_REGISTRY_SEARCH_BM25_THRESHOLD=0.0
BLUE_DATA_REGISTRY_SEARCH_VECTOR_THRESHOLD=0.5
BLUE_DATA_REGISTRY_SEARCH_COMBINED_THRESHOLD=0.36
BLUE_DATA_REGISTRY_SEARCH_HIERARCHICAL=true

# ---------------------------------------------------------------------------
# Sources — path to JSON file pre-loading data sources (optional)
# ---------------------------------------------------------------------------
BLUE_DATA_CONFIG=
# Format:
# {
#   "sources": [
#     {
#       "type": "sqlite",
#       "name": "mydb",
#       "properties": { "connection": { "database_directory": "/data/dbs" } }
#     }
#   ]
# }
