##### store
# registry persistence backend
export BLUE_DATA_REGISTRY_STORE=memory               # memory | redis | file

# redis (required when BLUE_DATA_REGISTRY_STORE=redis)
# requires Redis Stack (redis-stack-server), not plain Redis
export BLUE_DATA_REGISTRY_REDIS_URL=redis://localhost:6379/0
export BLUE_DATA_REGISTRY_REDIS_NAMESPACE=blue_data

# file (required when BLUE_DATA_REGISTRY_STORE=file, json-mcp only)
export BLUE_DATA_REGISTRY_FILE=blue_data_store.json

##### llm
# enables AI-augmented metadata enrichment and execute_query_nl (optional)
export BLUE_DATA_LLM_PROVIDER=              # anthropic | openai (leave blank to disable)
export BLUE_DATA_LLM_MODEL=                 # claude-opus-4-8 (anthropic) | gpt-4o (openai)
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=

##### search
# Vector/hybrid search. Without an embedding provider, registry search is BM25
# (keyword) only on the CLI/REST/MCP surfaces, and the vector settings below have
# no effect. Set a provider to enable the documented hybrid BM25 + vector search.
export BLUE_DATA_EMBEDDING_PROVIDER=            # openai (blank = keyword-only)
export BLUE_DATA_EMBEDDING_MODEL=               # default: text-embedding-3-small
export BLUE_DATA_REGISTRY_VECTOR_SOURCE=memory  # memory | redis
# registry search tuning
export BLUE_DATA_REGISTRY_VECTOR_DIM=1536
export BLUE_DATA_REGISTRY_SEARCH_BM25_WEIGHT=0.3
export BLUE_DATA_REGISTRY_SEARCH_VECTOR_WEIGHT=0.7
export BLUE_DATA_REGISTRY_SEARCH_VALUE_WEIGHT=0.15
export BLUE_DATA_REGISTRY_SEARCH_BM25_THRESHOLD=0.0
export BLUE_DATA_REGISTRY_SEARCH_VECTOR_THRESHOLD=0.5
export BLUE_DATA_REGISTRY_SEARCH_COMBINED_THRESHOLD=0.36
export BLUE_DATA_REGISTRY_SEARCH_HIERARCHICAL=true

##### sources
# path to JSON file pre-loading data sources (optional)
export BLUE_DATA_SOURCES_CONFIG=
# format:
# {
#   "sources": [
#     {
#       "type": "sqlite",
#       "name": "mydb",
#       "properties": { "connection": { "database_directory": "/data/dbs" } }
#     }
#   ]
# }

##### api (blue-data-api / REST API)
# bind address — defaults to loopback; set 0.0.0.0 to expose on all interfaces
export BLUE_DATA_API_HOST=127.0.0.1
export BLUE_DATA_API_PORT=8000
# auth — MANDATORY by default. Clients send the key via `X-API-Key: <key>` or
# `Authorization: Bearer <key>` (/health + docs stay open). If left blank, data
# endpoints return 401 unless auth is explicitly disabled below.
export BLUE_DATA_API_KEY=
# explicit opt-out: run without auth (dev only). Ignored when BLUE_DATA_API_KEY is set.
export BLUE_DATA_API_AUTH_DISABLED=false
# allow writes via POST /{source}/query (commit=true). off by default — the
# endpoint is read-only unless this is enabled
export BLUE_DATA_API_ALLOW_WRITES=false
