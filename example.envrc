##### store
# registry persistence backend
export BLUE_DATA_STORE=memory               # memory | redis | file

# redis (required when BLUE_DATA_STORE=redis)
# requires Redis Stack (redis-stack-server), not plain Redis
export BLUE_DATA_REDIS_URL=redis://localhost:6379/0
export BLUE_DATA_REDIS_NAMESPACE=blue_data

# file (required when BLUE_DATA_STORE=file, json-mcp only)
export BLUE_DATA_FILE=blue_data_store.json

##### llm
# enables AI-augmented metadata enrichment and execute_query_nl (optional)
export BLUE_DATA_LLM_PROVIDER=              # anthropic | openai (leave blank to disable)
export BLUE_DATA_LLM_MODEL=                 # claude-opus-4-8 (anthropic) | gpt-4o (openai)
export ANTHROPIC_API_KEY=
export OPENAI_API_KEY=

##### search
# registry search tuning
export BLUE_DATA_REGISTRY_VECTOR_DIM=1536
export BLUE_DATA_REGISTRY_SEARCH_BM25_WEIGHT=0.3
export BLUE_DATA_REGISTRY_SEARCH_VECTOR_WEIGHT=0.7
export BLUE_DATA_REGISTRY_SEARCH_VALUE_WEIGHT=0.15
export BLUE_DATA_REGISTRY_SEARCH_BM25_THRESHOLD=0.0
export BLUE_DATA_REGISTRY_SEARCH_VECTOR_THRESHOLD=0.5
export BLUE_DATA_REGISTRY_SEARCH_COMBINED_THRESHOLD=0.36
export BLUE_DATA_REGISTRY_SEARCH_HIERARCHICAL=true

##### sources
# path to JSON file pre-loading data sources (optional)
export BLUE_DATA_CONFIG=
# format:
# {
#   "sources": [
#     {
#       "type": "sqlite",
#       "name": "mydb",
#       "properties": { "connection": { "database_directory": "/data/dbs" } }
#     }
#   ]
# }
